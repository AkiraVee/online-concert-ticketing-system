  <script>
    // Demo User Accounts
    const validUsers = [
      { email: "user@example.com", password: "password123" },
      { email: "test@test.com", password: "test123" },
      { email: "demo@cinema.com", password: "demo123" },
    ];

    function isValidEmail(email) {
      return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
    }

    document.getElementById("loginForm").addEventListener("submit", function (e) {
      e.preventDefault();

      const email = document.getElementById("emailInput").value.trim();
      const password = document.getElementById("passwordInput").value.trim();

      // Reset errors
      document.getElementById("emailError").classList.add("hidden");
      document.getElementById("passwordError").classList.add("hidden");
      document.getElementById("credentialError").classList.add("hidden");

      let valid = true;

      if (!email) {
        document.getElementById("emailError").textContent = "Email is required.";
        document.getElementById("emailError").classList.remove("hidden");
        valid = false;
      } else if (!isValidEmail(email)) {
        document.getElementById("emailError").textContent = "Please enter a valid email address.";
        document.getElementById("emailError").classList.remove("hidden");
        valid = false;
      }

      if (!password) {
        document.getElementById("passwordError").textContent = "Password is required.";
        document.getElementById("passwordError").classList.remove("hidden");
        valid = false;
      } else if (password.length < 6) {
        document.getElementById("passwordError").textContent = "Password must be at least 6 characters.";
        document.getElementById("passwordError").classList.remove("hidden");
        valid = false;
      }

      if (!valid) return;

      // Check credentials
      const match = validUsers.find(u => u.email === email && u.password === password);

      if (match) {
        localStorage.setItem("userLoggedIn", "true");
        localStorage.setItem("userEmail", email);
        
        // Optional: Set cookie for persistence
        document.cookie = "userLoggedIn=true; path=/; max-age=86400";
        
        window.location.href = "homepage.php";
      } else {
        document.getElementById("credentialError").classList.remove("hidden");
      }
    });
  </script>
