Create Database ticketdb;
show databases;
use ticketDb;

Create TABLE usertb
(
UserID int(8) PRIMARY KEY AUTO_INCREMENT,
FullName varchar(30),
Email varchar(30),
Birthdate date,
Age int(2),
ContactNumber varchar (11),
password varchar(50)
);


Create TABLE ordertb
(
TicketID int(8) PRIMARY KEY AUTO_INCREMENT,
UserID int(8),
EventDate date,
SeatLocation varchar(50),
TicketQuantity int(5),
TotalPrice int(50),
TransactionPin int(8),
PurchaseDate date,
EventLocation varchar(100),
PaymentMethod varchar(20)
);


